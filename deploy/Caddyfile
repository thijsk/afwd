# Caddy installed on the host, with afwd-edge on 127.0.0.1:8080 and afwd-site on
# 127.0.0.1:8081 (their default addresses). The help domain (AFWD_HELP_DOMAIN, default
# afwd.nl) goes to the site; every other host goes to the edge.
{
	auto_https disable_redirects
	# No HTTP/3, as in the container setup (Caddyfile.container).
	servers {
		protocols h1 h2
	}
	on_demand_tls {
		ask http://127.0.0.1:8080/internal/cert-check
	}
}

(route) {
	log {
		output stdout
		format json
	}
	@site host {$AFWD_HELP_DOMAIN:afwd.nl}
	handle @site {
		reverse_proxy 127.0.0.1:8081
	}
	handle {
		reverse_proxy 127.0.0.1:8080
	}
}

:80 {
	# The help site is served only over HTTPS. Forwarded domains still answer over
	# HTTP, because their redirects come from their own AFWD records.
	@help_http host {$AFWD_HELP_DOMAIN:afwd.nl}
	redir @help_http https://{host}{uri} permanent
	import route
}

:443 {
	tls {
		on_demand
	}
	import route
}
