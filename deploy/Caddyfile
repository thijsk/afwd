{
	on_demand_tls {
		ask http://127.0.0.1:8080/internal/cert-check
	}
}

:80 {
	log {
		output stdout
		format json
	}

	@ip host matches regex `^([0-9]{1,3}\.){3}[0-9]{1,3}$|^\[[0-9A-Fa-f:.]+\]$|^([0-9A-Fa-f]{0,4}:){1,7}[0-9A-Fa-f]{0,4}$`
	handle @ip {
		respond 403
	}

	reverse_proxy 127.0.0.1:8080
}

:443 {
	log {
		output stdout
		format json
	}

	@ip host matches regex `^([0-9]{1,3}\.){3}[0-9]{1,3}$|^\[[0-9A-Fa-f:.]+\]$|^([0-9A-Fa-f]{0,4}:){1,7}[0-9A-Fa-f]{0,4}$`
	handle @ip {
		respond 403
	}

	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:8080
}