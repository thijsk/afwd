# Copy to deploy/.env and adjust. Every container reads this file.

# The public addresses of the service, comma-separated. The docs and the domain checker
# use them.
AFWD_PUBLIC_IPV4=192.0.2.1
AFWD_PUBLIC_IPV6=2001:db8::1

# The domain that shows the help site. The proxy sends it to the site container.
AFWD_HELP_DOMAIN=afwd.nl

# The hostname that domains point at with a CNAME or ALIAS. Defaults to fwd.<help domain>.
# Set it to an empty value to offer only A and AAAA records.
#AFWD_TARGET_HOST=fwd.afwd.nl

# Host ports for HTTP and HTTPS.
#AFWD_HTTP_PORT=80
#AFWD_HTTPS_PORT=443

# Which published images to run, for `docker compose pull`.
#AFWD_IMAGE=ghcr.io/thijsk/afwd
#AFWD_TAG=main
