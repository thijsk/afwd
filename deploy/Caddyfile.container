{
	auto_https disable_redirects
	http_port 8080
	https_port 8443

	on_demand_tls {
		ask http://127.0.0.1:9000/internal/cert-check
	}
}

:80 {
	log {
		output stdout
		format json
	}
	reverse_proxy 127.0.0.1:9000
}

:443 {
	log {
		output stdout
		format json
	}
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:9000
}
