# The proxy container. The help domain (AFWD_HELP_DOMAIN, default afwd.nl) goes to the
# site container; every other host is a forwarded domain and goes to the edge container.
{
	auto_https disable_redirects
	http_port 8080
	https_port 8443

	on_demand_tls {
		ask http://edge:9000/internal/cert-check
	}
}

(route) {
	log {
		output stdout
		format json
	}
	@site host {$AFWD_HELP_DOMAIN:afwd.nl}
	handle @site {
		reverse_proxy site:9000
	}
	handle {
		reverse_proxy edge:9000
	}
}

:8080 {
	# The help site is served only over HTTPS. Forwarded domains still answer over
	# HTTP, because their redirects come from their own AFWD records.
	@help_http host {$AFWD_HELP_DOMAIN:afwd.nl}
	redir @help_http https://{host}{uri} permanent
	import route
}

:8443 {
	tls {
		on_demand
	}
	import route
}
